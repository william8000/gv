!
!##########################################################
!##### gv_hidpi.dat
!#####
!##### Style for high resolution displays: every size, margin
!##### and font is roughly doubled with respect to the stock
!##### resources.  Intended for 4K and other high DPI screens,
!##### or for anyone who simply wants a larger interface.
!#####
!##### Selected with 'gv --hidpi' or 'gv --style=gv_hidpi.dat'.
!#####
!##### Specifications must match the stock ones exactly,
!##### including the binding: Xrm prefers a tight binding ('.')
!##### over a loose one ('*'), so a loose override never
!##### replaces a stock tight specification.
!##########################################################

!##### General

GV*highlightThickness:			2

!##### Shadows

GV*shadowWidth:				4
GV*Label.shadowWidth:			2

!##### Border

GV*page.borderWidth:			2
GV*SimpleMenu.borderWidth:		2
GV*infoPopup*Text.borderWidth:		2

!##### View Area

GV*viewFrame.hSpace:			2
GV*viewFrame.vSpace:			2
GV*viewClip.borderWidth:		2

!##### Scrollbar widget

GV*Scrollbar.thickness:			34

!##### Menus

GV*magMenu*VertSpace:			30
GV*magMenu*leftMargin:			60
GV*magMenu*rightMargin:			60

!##### File Selection widget

GV*fileSel.filterframe.hSpace:		8
GV*fileSel.filterframe*Text*Margin:	8
GV*fileSel.pathframe.hSpace:		8
GV*fileSel.pathframe*Text*Margin:	12

GV*fileSel*topframe.forcedWidth:	200
GV*fileSel*subframe.forcedWidth:	200

GV*fileSel*Scrollbar.width:		24
GV*fileSel*Scrollbar.shadowWidth:	2

GV*fileSel.minimumWidth:		800
GV*fileSel.height:			700
GV*fileSelPopup.minWidth:		700
GV*fileSelPopup.minHeight:		400

!##### Zoom Popup

GV*zoomControl.maximumWidth:		1200
GV*zoomControl.maximumHeight:		1200

!##### Version Popup

GV*versionPopup*Label.internalHeight:	12
GV*versionPopup*Label.internalWidth:	16

!##### Info Popup

GV*infoPopup.geometry:			+100+100

!##### Dialog Popup

GV*dialogPopup*message.internalHeight:	4
GV*dialogPopup*message.internalWidth:	16
GV*dialogPopup*defaultDistance:		4

!##### Note Popup

GV*notePopup*message.internalHeight:	12
GV*notePopup*message.internalWidth:	16

!##### Confirm Popup

GV*confirmPopup*Label.internalHeight:	12
GV*confirmPopup*Label.internalWidth:	16

!##### OptionsFS Popup

GV*optionfsPopup*defaultDistance:	4
GV*optionfsPopup*Text*leftMargin:	16
GV*optionfsPopup*filters.Margin:	16
GV*optionfsPopup*dirs.Margin:		16
GV*optionfsPopup*filters.height:	240
GV*optionfsPopup*dirs.height:		240

!##### OptionsGS Popup

GV*optiongsPopup*defaultDistance:	4
GV*optiongsPopup*Text*Margin:		10

!##### OptionsSetup Popup

GV*optionsetupPopup*defaultDistance:	4
GV*optionsetupPopup*Text*leftMargin:	16
GV*optionsetupPopup*scales.Margin:	16
GV*optionsetupPopup*scalesFrame.forcedWidth:	460
GV*optionsetupPopup*mediasFrame.forcedWidth:	480
GV*optionsetupPopup*mediasFrame.forcedHeight:	800

!##### Panner

GV*pannerFrame.shadowWidth:		2
GV*panner.width:			100
GV*panner.height:			100

GV*slider.shadowWidth:			2

!##### Miscellaneous

GV*stateButton*menu*leftMargin:		40
GV*orientationButton*menu*leftMargin:	40
GV*pagemediaButton*menu*leftMargin:	40
GV*scaleButton*menu*leftMargin:		40
GV.control.prevPage*internalHeight:	8
GV.control.nextPage*internalHeight:	8
GV*locator*internalHeight:		6

